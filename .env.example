# ---- Core ----
NODE_ENV=development
API_PORT=3001
WEB_URL=http://localhost:3000

# ---- Database ----
# Local (docker compose). Production must use the orderpilot_app role, NOT the
# owner role, or row level security is bypassed.
DATABASE_URL=postgres://orderpilot_app:change_me_in_deploy@localhost:5432/orderpilot
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/orderpilot

REDIS_URL=redis://localhost:6379

# ---- Meta ----
# App secret signs every webhook. Rotate it if it ever touches a log.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=pick_any_long_random_string
META_GRAPH_VERSION=v21.0

FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=

# ---- AI ----
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-haiku-4-5-20251001
REPLY_MODEL=claude-sonnet-5

# ---- Courier (pick one to start) ----
COURIER_PROVIDER=steadfast
COURIER_API_KEY=
COURIER_API_SECRET=

# ---- Auth ----
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Web dashboard ----
# Where the web app reaches the API, and which tenant it renders. DEMO_TENANT_ID
# is placeholder auth for local dev only — production derives the tenant from the
# signed-in Clerk session, never from config. Get the id after `pnpm db:seed`:
#   docker compose -f infra/docker-compose.yml exec postgres \
#     psql -U postgres -d orderpilot -c "select id from tenants where slug='demo-shoe-spray'"
API_URL=http://localhost:3001
DEMO_TENANT_ID=
