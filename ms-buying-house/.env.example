# Public site URL — used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://msbuyinghouse.com

# --- Contact form delivery (optional) ---
# The /api/contact route works without these: submissions are validated and
# logged. Add a Resend API key to have enquiries emailed to your sourcing desk.
# https://resend.com
RESEND_API_KEY=
CONTACT_TO_EMAIL=sourcing@msbuyinghouse.com
CONTACT_FROM_EMAIL=website@msbuyinghouse.com
