{
  "name": "orderpilot",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "pnpm build:libs && pnpm -r --parallel dev",
    "dev:api": "pnpm build:libs && pnpm --filter @orderpilot/api dev",
    "dev:web": "pnpm --filter @orderpilot/web dev",
    "build": "pnpm -r build",
    "build:libs": "pnpm --filter @orderpilot/shared --filter @orderpilot/db -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @orderpilot/db generate",
    "db:migrate": "pnpm --filter @orderpilot/db migrate",
    "db:seed": "pnpm --filter @orderpilot/db seed",
    "setup": "pnpm build:libs && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "tunnel": "cloudflared tunnel --url http://localhost:3001"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  }
}
